{
  "version": 2,
  "cleanUrls": true,
  "crons": [
    {
      "path": "/api/nightly-reminder",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/check-timers",
      "schedule": "* * * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
